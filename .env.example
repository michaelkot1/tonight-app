# Public Expo client vars (safe to embed in the binary)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — use in Edge Functions / API routes later. Do NOT prefix with EXPO_PUBLIC_.
TMDB_API_KEY=
OMDB_API_KEY=

# OAuth (DEFERRED — native Apple/Google sign-in is not wired yet in Phase 2).
# Optional/nullable: leave blank until Google Sign-In is enabled. These are client
# IDs (not secrets). Apple sign-in needs no public env var.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
